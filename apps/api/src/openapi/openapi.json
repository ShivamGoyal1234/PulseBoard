    "/api/polls/{id}/responses": {
      "post": {
        "tags": ["Responses"],
        "summary": "Submit responses",
        "description": "Submit answers for a poll. Optional `Authorization: Bearer` ties response to user when poll is not anonymous. Optional `X-Fingerprint` dedupes anonymous submissions per poll for 24h. Subject to submit rate limiting.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" },
            "description": "Poll ID"
          },
          {
            "name": "X-Fingerprint",
            "in": "header",
            "required": false,
            "schema": { "type": "string" },
            "description": "Client fingerprint for anonymous deduplication"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/SubmitResponseRequest" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Response recorded",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/SubmitResponseResult" }
              }
            }
          },
          "401": {
            "description": "Non-anonymous poll requires authenticated respondent",
            "content": {
              "application/json": {
                "example": { "error": "Authentication required for this poll" }
              }
            }
          },
          "404": {
            "description": "Poll not found",
            "content": {
              "application/json": {
                "example": { "error": "Resource not found" }
              }
            }
          },
          "409": {
            "description": "Duplicate fingerprint submission or conflict",
            "content": {
              "application/json": {
                "examples": {
                  "duplicate": {
                    "value": { "error": "You have already responded to this poll" }
                  }
                }
              }
            }
          },
          "410": {
            "description": "Poll inactive or expired",
            "content": {
              "application/json": {
                "example": { "error": "This poll has expired" }
              }
            }
          },
          "422": {
            "description": "Schema or business validation failed",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    { "$ref": "#/components/schemas/ValidationError" },
                    { "$ref": "#/components/schemas/ValidationErrorDomain" }
                  ]
                }
              }
            }
          },
          "429": {
            "description": "Too many submissions (rate limit)"
          }
        }
      }
    },
